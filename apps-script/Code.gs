/**
 * OMAC International — Research Forum
 * Backend for a Google Apps Script web app that serves JSON-defined
 * questionnaires and stores responses in a bound Google Sheet.
 *
 * SHEETS USED (created automatically by setup()):
 *   "Questionnaires" — id | title | status | schema_json | created_at
 *   "Responses"       — timestamp | questionnaire_id | answers_json
 *
 * DEPLOY: Extensions > Apps Script on a Google Sheet, paste this file
 * as Code.gs and Index.html as Index.html, run setup() once from the
 * editor (approve permissions), then Deploy > New deployment > Web app
 * (Execute as: Me, Who has access: Anyone with the link).
 */

const QUESTIONNAIRES_SHEET = "Questionnaires";
const RESPONSES_SHEET = "Responses";
const ACCOUNTS_SHEET = "Accounts";

// ---------- Web app entry point ----------

function doGet(e) {
  if (e && e.parameter && e.parameter.action === "schema") {
    const schema = e.parameter.id ? getQuestionnaireById(e.parameter.id) : getActiveQuestionnaire();
    return jsonResponse_(schema || { error: "No active questionnaire" });
  }
  if (e && e.parameter && e.parameter.admin === "1") {
    return HtmlService.createHtmlOutputFromFile("Admin")
      .setTitle("OMAC International — Admin")
      .addMetaTag("viewport", "width=device-width, initial-scale=1");
  }
  const template = HtmlService.createTemplateFromFile("Index");
  template.logoBase64 = LOGO_BASE64_;
  return template
    .evaluate()
    .setTitle("OMAC International — Research Forum")
    .addMetaTag("viewport", "width=device-width, initial-scale=1")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * POST endpoint used by the GitHub-Pages (static) frontend, which cannot
 * use google.script.run. Two shapes are accepted, routed by body.action:
 *   - no action / action "submitResponse": {"questionnaireId","answers"} — public, no auth
 *   - action "adminLogin" | "adminListQuestionnaires" | "adminAddQuestionnaire"
 *     | "adminSetStatus": {"action","username","password", ...} — admin only
 * Sent with Content-Type: text/plain from the browser to avoid a CORS
 * preflight request, which Apps Script web apps do not handle.
 */
function doPost(e) {
  try {
    const body = JSON.parse(e.postData.contents);
    switch (body.action) {
      case "adminLogin":
        return jsonResponse_({ ok: verifyAdmin_(body.username, body.password) });
      case "adminListQuestionnaires":
        return jsonResponse_(requireAdmin_(body, function () { return { ok: true, items: listQuestionnaires() }; }));
      case "adminAddQuestionnaire":
        return jsonResponse_(requireAdmin_(body, function () {
          addQuestionnaire(body.id, body.title, body.schemaJson, body.exclusive !== false);
          return { ok: true };
        }));
      case "adminSetStatus":
        return jsonResponse_(requireAdmin_(body, function () {
          setQuestionnaireStatus_(body.id, body.status);
          return { ok: true };
        }));
      default:
        submitResponse(body.questionnaireId, body.answers);
        return jsonResponse_({ ok: true });
    }
  } catch (err) {
    return jsonResponse_({ ok: false, error: String(err) });
  }
}

function jsonResponse_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

function requireAdmin_(body, fn) {
  if (!verifyAdmin_(body.username, body.password)) return { ok: false, error: "Invalid admin credentials" };
  return fn();
}

// Base64-encoded OMAC wordmark (transparent PNG), embedded so the app
// needs no external image hosting. Replace this string to update the logo.
const LOGO_BASE64_ = ``;

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

// ---------- One-time setup ----------

/**
 * Run this once from the Apps Script editor (select "setup" in the
 * function dropdown, click Run). Creates both sheets if missing, with
 * headers only — no questionnaire is seeded automatically. You add the
 * first (and every later) questionnaire yourself, as admin, either by:
 *   (a) pasting its JSON directly into the "schema_json" column of a
 *       new row on the Questionnaires sheet, with status = "open", or
 *   (b) running addQuestionnaire(id, title, jsonString) from this editor.
 */
function setup() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  let qSheet = ss.getSheetByName(QUESTIONNAIRES_SHEET);
  if (!qSheet) {
    qSheet = ss.insertSheet(QUESTIONNAIRES_SHEET);
    qSheet.appendRow(["id", "title", "status", "schema_json", "created_at"]);
    qSheet.setFrozenRows(1);
  }

  let rSheet = ss.getSheetByName(RESPONSES_SHEET);
  if (!rSheet) {
    rSheet = ss.insertSheet(RESPONSES_SHEET);
    rSheet.appendRow(["timestamp", "questionnaire_id", "answers_json"]);
    rSheet.setFrozenRows(1);
  }

  let aSheet = ss.getSheetByName(ACCOUNTS_SHEET);
  if (!aSheet) {
    aSheet = ss.insertSheet(ACCOUNTS_SHEET);
    aSheet.appendRow(["username", "password", "created_at"]);
    aSheet.setFrozenRows(1);
    aSheet.hideSheet();
  }

  SpreadsheetApp.flush();
  Logger.log("Setup complete. No questionnaire is loaded yet — add one via the Questionnaires sheet or addQuestionnaire(). Add your own admin login on the Accounts sheet (it's hidden by default — right-click a sheet tab > Unhide sheet to find it).");
}

// ---------- Public API called from Index.html via google.script.run ----------

/**
 * Returns the currently active ("open") questionnaire schema.
 * If more than one is marked open, returns the most recently created.
 */
function getActiveQuestionnaire() {
  const sheet = getSheet_(QUESTIONNAIRES_SHEET);
  const rows = sheet.getDataRange().getValues();
  let best = null;
  for (let i = 1; i < rows.length; i++) {
    const [id, title, status, schemaJson, createdAt] = rows[i];
    if (status === "open") {
      if (!best || new Date(createdAt) > new Date(best.createdAt)) {
        best = { id, title, status, schemaJson, createdAt };
      }
    }
  }
  if (!best) return null;
  const schema = JSON.parse(best.schemaJson);
  schema.id = best.id;
  return schema;
}

/** Returns a specific questionnaire by id, regardless of status. */
function getQuestionnaireById(id) {
  const sheet = getSheet_(QUESTIONNAIRES_SHEET);
  const rowIndex = findQuestionnaireRow_(sheet, id);
  if (rowIndex === -1) return null;
  const row = sheet.getRange(rowIndex + 1, 1, 1, 5).getValues()[0];
  const schema = JSON.parse(row[3]);
  schema.id = row[0];
  return schema;
}

/** Appends one completed response. answers is a plain object keyed by question id. */
function submitResponse(questionnaireId, answers) {
  const sheet = getSheet_(RESPONSES_SHEET);
  sheet.appendRow([new Date(), questionnaireId, JSON.stringify(answers)]);
  return { ok: true };
}

// ---------- Admin helpers (run from the Apps Script editor or your own admin sheet) ----------

/**
 * Adds a new questionnaire from a JSON string (e.g. paste the contents
 * of a new questionnaire_<name>.json file here) and marks it open.
 * By default this closes every other questionnaire so only one is
 * live at a time — pass exclusive=false to allow several open at once.
 */
function addQuestionnaire(id, title, schemaJsonString, exclusive) {
  if (exclusive !== false) closeAllQuestionnaires();
  const sheet = getSheet_(QUESTIONNAIRES_SHEET);
  const rowIndex = findQuestionnaireRow_(sheet, id);
  if (rowIndex !== -1) {
    sheet.getRange(rowIndex + 1, 2, 1, 3).setValues([[title, "open", schemaJsonString]]);
  } else {
    sheet.appendRow([id, title, "open", schemaJsonString, new Date()]);
  }
}

function closeQuestionnaire(id) {
  setQuestionnaireStatus_(id, "closed");
}

function openQuestionnaire(id, exclusive) {
  if (exclusive !== false) closeAllQuestionnaires();
  setQuestionnaireStatus_(id, "open");
}

function closeAllQuestionnaires() {
  const sheet = getSheet_(QUESTIONNAIRES_SHEET);
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;
  const statusRange = sheet.getRange(2, 3, lastRow - 1, 1);
  const values = statusRange.getValues().map(() => ["closed"]);
  statusRange.setValues(values);
}

// ---------- internal ----------

function getSheet_(name) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(name);
  if (!sheet) throw new Error('Sheet "' + name + '" not found. Run setup() first.');
  return sheet;
}

function findQuestionnaireRow_(sheet, id) {
  const ids = sheet.getRange(2, 1, Math.max(sheet.getLastRow() - 1, 0), 1).getValues();
  for (let i = 0; i < ids.length; i++) {
    if (ids[i][0] === id) return i + 1; // 0-based data row index (sheet row = this + 1)
  }
  return -1;
}

function setQuestionnaireStatus_(id, status) {
  const sheet = getSheet_(QUESTIONNAIRES_SHEET);
  const rowIndex = findQuestionnaireRow_(sheet, id);
  if (rowIndex === -1) throw new Error('Questionnaire "' + id + '" not found.');
  sheet.getRange(rowIndex + 1, 3).setValue(status);
}

// ---------- Admin auth & panel API ----------

/**
 * Checks username/password against the (hidden) Accounts sheet.
 * Add your own row there: username | password | created_at.
 * Plain-text match — adequate for gating a low-stakes internal panel,
 * not a substitute for real auth if this ever protects sensitive data.
 */
function verifyAdmin_(username, password) {
  if (!username || !password) return false;
  const sheet = getSheet_(ACCOUNTS_SHEET);
  const rows = sheet.getDataRange().getValues();
  for (let i = 1; i < rows.length; i++) {
    if (String(rows[i][0]) === String(username) && String(rows[i][1]) === String(password)) return true;
  }
  return false;
}

/** Returns every questionnaire's id/title/status/created_at (not the full schema). */
function listQuestionnaires() {
  const sheet = getSheet_(QUESTIONNAIRES_SHEET);
  const rows = sheet.getDataRange().getValues();
  const items = [];
  for (let i = 1; i < rows.length; i++) {
    items.push({ id: rows[i][0], title: rows[i][1], status: rows[i][2], createdAt: rows[i][4] });
  }
  return items;
}

// The following are the google.script.run-facing versions used by Admin.html
// when hosted directly by Apps Script. They mirror the doPost "admin*" actions.

function adminLogin(username, password) {
  return { ok: verifyAdmin_(username, password) };
}

function adminListQuestionnaires(username, password) {
  if (!verifyAdmin_(username, password)) return { ok: false, error: "Invalid admin credentials" };
  return { ok: true, items: listQuestionnaires() };
}

function adminAddQuestionnaire(username, password, id, title, schemaJson, exclusive) {
  if (!verifyAdmin_(username, password)) return { ok: false, error: "Invalid admin credentials" };
  addQuestionnaire(id, title, schemaJson, exclusive !== false);
  return { ok: true };
}

function adminSetStatus(username, password, id, status) {
  if (!verifyAdmin_(username, password)) return { ok: false, error: "Invalid admin credentials" };
  setQuestionnaireStatus_(id, status);
  return { ok: true };
}
